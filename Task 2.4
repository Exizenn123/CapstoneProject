WITH monthly AS (
    SELECT
        SUBSTR(appt_date, 1, 7) AS month,
        COUNT(*) AS appointments,
        ROUND(
            100.0 * SUM(no_show) / COUNT(*), 1
        ) AS no_show_pct
    FROM appointments
    GROUP BY SUBSTR(appt_date, 1, 7)
)

SELECT
    month,
    appointments,
    no_show_pct,
    LAG(no_show_pct) OVER (
        ORDER BY month
    ) AS previous_month_pct,
    ROUND(
        no_show_pct - LAG(no_show_pct) OVER (
            ORDER BY month
        ), 1
    ) AS change_percentage_points
FROM monthly
ORDER BY month;
