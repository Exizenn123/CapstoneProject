CLINIC WITH THE HIGHEST RATE AND THE NUMBER OF APPOINTMENTS:-

Gomti Nagar Care Point:
APPOINTMENTS:90
no_show_pct:33.3%
------------------------------------------------------------

import pandas as pd

appointments = pd.read_csv("appointments_clean.csv")
clinics = pd.read_csv("clinics_enriched (1).csv")

merged = appointments.merge(
    clinics,
    on="clinic_id",
    how="inner"
)

result = merged.groupby(
    ["clinic_id", "clinic_name", "city"]
).agg(
    appointments=("appointment_id", "count"),
    no_shows=("no_show", "sum")
).reset_index()

result["no_show_pct"] = (
    100 * result["no_shows"] / result["appointments"]
).round(1)

result = result.sort_values(
    by="no_show_pct",
    ascending=False
)
